{
  "name": "acts-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n mock,app -c cyan,magenta \"npm:start:mock\" \"npm:start:app\"",
    "start:app": "ng serve",
    "start:mock": "node mock-server/server.mjs",
    "generate:api": "node scripts/generate-api.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:ui && npm run test:mock",
    "test:ui": "ng test --watch=false",
    "test:mock": "node --test \"mock-server/*.test.mjs\"",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/material-icons": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "21.4.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.3.0",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "~4.0.18"
  }
}
